akes a lie taste of ash","shows you shapes of the future in the smoke"]},"voice":{"words":["Whisper","Echo","Bell","Raven-Call"],"effects":["lets you hear a conversation through a wall","tells you the name of a stranger","lets you hear the last words spoken in a room"]}}},"enchantment":{"ends":["song","lull","charm","smile","glamour","word","sway","tune","hush","spell"],"types":["Charm","Glamour","Lullaby","Command","Beguilement","Whisper"],"themes":{"sleep":{"words":["Cradle","Dream","Poppy","Lavender","Moth"],"effects":["sends a guard to sleep where they stand","fills dreams with a message of your choosing","makes one person forget the last minute"]},"song":{"words":["Siren","Lark","Starling","Nightingale","Bell"],"effects":["makes the target fall under the spell of the next song they hear","calms an angry crowd","makes a beast follow you like a lamb"]},"sweet":{"words":["Honey","Sweet","Rose","Silk","Velvet"],"effects":["makes the target believe you're an old friend","gives a stranger a sudden urge to help you","makes the target too polite to refuse you","lets you speak a single word that must be obeyed"]},"mirth":{"words":["Mirth","Feather","Sunny","Merry"],"effects":["fills a room with helpless laughter","turns fear into courage for your friends","makes everyone nearby forget their quarrels"]}}},"evocation":{"ends":["bolt","flare","lash","strike","brand","shard","storm","fang","crack","roar"],"types":["Bolt","Lance","Storm","Flare","Nova","Lash"],"themes":{"fire":{"words":["Ember","Cinder","Flame","Blaze","Kindle"],"effects":["sets a ring of fire around you","lights every candle in the room at once","brands a glowing mark on a foe so they can't hide","hurls a ball of flame the size of a fist"]},"storm":{"words":["Squall","Thunder","Gale","Tempest"],"effects":["calls down a crack of thunder that knocks foes flat","sends a gale that blows out every torch","blasts a door off its hinges","sends sparks leaping from foe to foe"]},"frost":{"words":["Frost","Hail","Rime","Sleet"],"effects":["freezes a pond solid in a heartbeat","showers the area with stinging hail","throws a spear of ice","coats the floor in ice so foes slip and fall"]},"star":{"words":["Star","Comet","Spark","Sun"],"effects":["sends a single star streaking across the battlefield","hurls a burning comet the size of a fist","throws a spear of cold white light","blinds foes with a flash of sunlight"]}}},"illusion":{"ends":["mask","glamour","shade","double","fade","shimmer","twist","cloak","dream"],"types":["Veil","Mask","Mirage","Phantasm","Glamour","Trick"],"themes":{"mirror":{"words":["Mirror","Twin","Echo","Moonglass"],"effects":["makes three copies of you that copy your every move","makes a voice seem to come from somewhere else","makes you look like someone else for an hour"]},"shadow":{"words":["Shadow","Dusk","Smoke","Mist","Haze"],"effects":["turns you invisible while you stand still","covers a camp in a mirage of empty moorland","makes a pit look like solid floor","hides a door behind a painted wall"]},"phantom":{"words":["Phantom","Ghost","Fable","Nightmare"],"effects":["fills a corridor with phantom footsteps","makes the target see their worst fear in every shadow","makes a small room seem endless"]},"glimmer":{"words":["Glimmer","Gossamer","Masque","Silver"],"effects":["makes a coin look like gold to everyone but you","makes a sword look like a walking stick","dresses you in borrowed finery for a night"]}}},"necromancy":{"ends":["mark","rot","drain","grip","chill","toll","reap","bind","knell","wane"],"types":["Hex","Curse","Toll","Rite","Mark","Knell"],"themes":{"grave":{"words":["Bone","Grave","Crypt","Barrow","Marrow"],"effects":["lets you ask a skull three questions","wakes a skeleton to carry your bags","tells you how someone died","lets you speak with the last spirit to leave a place"]},"wither":{"words":["Wither","Hemlock","Yew","Sallow","Ash"],"effects":["makes flowers wilt in a circle around you","curses the target with terrible luck until dawn"