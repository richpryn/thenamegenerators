    "hero": {
      "title": "🏠 Gingerbread House Name Generator",
      "tagline": "A name for the sign over the door, or for your team in the gingerbread house competition."
    },
    "intro": "Every gingerbread house deserves a name on its little sign, from cosy Gumdrop Cottage to the slightly nibbled Wuthering Bites. This **gingerbread house name generator** names the house itself or your team for a gingerbread house competition, in cute, funny, grand or spooky styles, with no brand-name sweets.",
    "sections": [],
    "faqs": [
      {
        "question": "What are some funny gingerbread house names?",
        "answer": "The best ones laugh at the build: Subsidence Cottage, Grade II Listed Biscuit or Room with a Chew. If yours has gone wonky, lean into it with names like Mostly Standing or Held Together by Icing. Choose Funny for more."
      },
      {
        "question": "What is a good team name for a gingerbread house competition?",
        "answer": "A baking or building pun that judges will read out with a grin, such as Whisk Takers, Frost Responders or Pipe Dreams. Choose Team name, then a style: cute for children, grand for a showpiece, spooky for a haunted house."
      }
    ]
