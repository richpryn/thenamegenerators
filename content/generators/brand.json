{
  "title": "Brand Name Generator",
  "slug": "brand-name-generator",
  "icon": "🏷️",
  "category": "organizations",
  "published": "2025-12-01",
  "description": "Brand and product names sorted by industry and feel, from tech and luxury to food, fashion and outdoor, as one word or with a product word (Juniper Botanicals).",
  "seoKeywords": "brand name generator, brand names, product name generator, product names, brand name ideas, brandable names, clothing brand names",
  "isPopular": true,
  "popularRank": 7,
  "filters": {
    "category": {
      "label": "Industry or feel",
      "options": [
        "all_categories",
        "tech_innovation",
        "luxury_premium",
        "nature_organic",
        "bold_athletic",
        "modern_minimalist",
        "food_beverage",
        "creative_artistic",
        "urban_street",
        "ocean_maritime",
        "desert_earth",
        "space_cosmic",
        "heritage_vintage",
        "energy_power",
        "fashion_style",
        "health_wellness",
        "adventure_outdoor",
        "home_living",
        "entertainment_media"
      ],
      "optionLabels": {
        "all_categories": "All categories",
        "tech_innovation": "Tech and software",
        "luxury_premium": "Luxury and premium",
        "nature_organic": "Natural and organic",
        "bold_athletic": "Sport and fitness",
        "modern_minimalist": "Modern and minimal",
        "food_beverage": "Food and drink",
        "creative_artistic": "Art and design",
        "urban_street": "Streetwear and urban",
        "ocean_maritime": "Ocean and coastal",
        "desert_earth": "Desert and earth",
        "space_cosmic": "Space and science",
        "heritage_vintage": "Heritage and vintage",
        "energy_power": "Energy and power",
        "fashion_style": "Fashion",
        "health_wellness": "Health and wellness",
        "adventure_outdoor": "Outdoor and adventure",
        "home_living": "Home and interiors",
        "entertainment_media": "Music, film and media"
      }
    },
    "format": {
      "label": "Name Format",
      "options": [
        "word",
        "with_ending"
      ],
      "optionLabels": {
        "word": "One word (Juniper)",
        "with_ending": "With a product word (Juniper Botanicals)"
      }
    }
  },
  "recipe": "switch",
  "on": "format",
  "cases": {
    "word": {
      "recipe": "switch",
      "on": "category",
      "cases": {
        "all_categories": {
          "recipe": "pick",
          "from": "words"
        }
      },
      "default": {
        "recipe": "pick",
        "from": "words.{category}"
      }
    },
    "with_ending": {
      "recipe": "switch",
      "on": "category",
      "cases": {
        "all_categories": {
          "recipe": "template",
          "template": [
            "[words.tech_innovation] [endings.tech_innovation]",
            "[words.luxury_premium] [endings.luxury_premium]",
            "[words.nature_organic] [endings.nature_organic]",
            "[words.bold_athletic] [endings.bold_athletic]",
            "[words.modern_minimalist] [endings.modern_minimalist]",
            "[words.food_beverage] [endings.food_beverage]",
            "[words.creative_artistic] [endings.creative_artistic]",
            "[words.urban_street] [endings.urban_street]",
            "[words.ocean_maritime] [endings.ocean_maritime]",
            "[words.desert_earth] [endings.desert_earth]",
            "[words.space_cosmic] [endings.space_cosmic]",
            "[words.heritage_vintage] [endings.heritage_vintage]",
            "[words.energy_power] [endings.energy_power]",
            "[words.fashion_style] [endings.fashion_style]",
            "[words.health_wellness] [endings.health_wellness]",
            "[words.adventure_outdoor] [endings.adventure_outdoor]",
            "[words.home_living] [endings.home_living]",
            "[words.entertainment_media] [endings.entertainment_media]"
          ]
        }
      },
      "default": {
        "recipe": "template",
        "template": "[words.{category}] [endings.{category}]"
      }
    }
  },
