  "noEcho": true,
  "recipe": "switch",
  "on": "format",
  "cases": {
    "name": {
      "recipe": "switch",
      "on": "style",
      "cases": {
        "any": {
          "recipe": "pick",
          "from": "names"
        }
      },
      "default": {
        "recipe": "pick",
        "from": "names.{style}"
      }
    },
    "description": {
      "recipe": "switch",
      "on": "style",
      "cases": {
        "any": {
          "recipe": "template",
          "template": [
            "[names.fantasy], [descriptions.fantasy]",
            "[names.stormy], [descriptions.stormy]",
            "[names.frozen], [descriptions.frozen]",
            "[names.tropical], [descriptions.tropical]",
            "[names.mythic], [descriptions.mythic]"
          ]
        }
      },
      "default": {
        "recipe": "template",
        "template": "[names.{style}], [descriptions.{style}]"
      }
    }
  },
