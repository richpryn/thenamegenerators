{
  "title": "Mecha Name Generator",
  "slug": "mecha-name-generator",
  "icon": "🦾",
  "category": "scifi",
  "published": "2026-10-22",
  "description": "Names for giant robots and mechs: military real-robot frames with model numbers, and super robots with grand prefixes and titles.",
  "seoKeywords": "mecha name generator, mech name generator, giant robot names, gundam name generator, mech names, mecha names, battle mech names, super robot names",
  "seoTitle": "Mecha Name Generator: Giant Robot & Mech Names",
  "isPopular": false,
  "filters": {
    "style": {
      "label": "Kind of mecha",
      "options": [
        "any",
        "real",
        "super"
      ],
      "optionLabels": {
        "any": "Any (a mix)",
        "real": "Real robot, a military machine (KR-07 Harrier)",
        "super": "Super robot, a hero machine (Great Thundaros)"
      }
    },
    "format": {
      "label": "Name format",
      "options": [
        "name",
        "full",
        "class"
      ],
      "optionLabels": {
        "name": "Name only",
        "full": "With a model number or prefix",
        "class": "With its class or title"
      }
    }
  },
  "recipe": "switch",
  "on": "format",
  "cases": {
    "name": {
      "recipe": "switch",
      "on": "style",
      "cases": {
        "real": {
          "recipe": "template",
          "template": "[real]"
        },
        "super": {
          "recipe": "template",
          "template": "[super]"
        },
        "any": {
          "recipe": "template",
          "template": [
            "[real]",
            "[super]"
          ]
        }
      }
    },
    "full": {
      "recipe": "switch",
      "on": "style",
      "cases": {
        "real": {
          "recipe": "template",
          "template": "[code]-[num] [real]"
        },
        "super": {
          "recipe": "template",
          "template": "[superpre] [super]"
        },
        "any": {
          "recipe": "template",
          "template": [
            "[code]-[num] [real]",
            "[superpre] [super]"
          ]
        }
      }
    },
    "class": {
      "recipe": "switch",
      "on": "style",
      "cases": {
        "real": {
          "recipe": "template",
          "template": [
            "[real], [realclass]",
            "[code]-[num] [real], [realclass]"
          ]
        },
        "super": {
          "recipe": "template",
          "template": [
            "[super], [superclass]",
            "[superpre] [super], [superclass]"
          ]
        },
        "any": {
          "recipe": "template",
          "template": [
            "[real], [realclass]",
            "[code]-[num] [real], [realclass]",
            "[super], [superclass]",
            "[superpre] [super], [superclass]"
          ]
        }
      }
    }
  },
