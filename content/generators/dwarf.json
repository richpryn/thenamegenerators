{
  "title": "Dwarf Name Generator",
  "slug": "dwarf-name-generator",
  "icon": "⛏️",
  "category": "fantasy",
  "published": "2025-11-30",
  "description": "Dwarf names with a clan to match: mountain clans of iron and stone, hill clans of ale and hearth, or the old \"son of\" style. Male and female.",
  "seoKeywords": "dwarf names, dwarf name generator, fantasy dwarf names, dnd dwarf names, female dwarf names, dwarf clan names, mountain dwarf names, hill dwarf names",
  "isPopular": true,
  "popularRank": 5,
  "filters": {
    "gender": {
      "label": "Gender",
      "options": [
        "any",
        "male",
        "female"
      ],
      "optionLabels": {
        "any": "Any",
        "male": "Male",
        "female": "Female"
      }
    },
    "kind": {
      "label": "Dwarf",
      "options": [
        "mountain",
        "hill"
      ],
      "optionLabels": {
        "mountain": "Mountain dwarf (Ironhelm)",
        "hill": "Hill dwarf (Barleybrew)"
      }
    },
    "format": {
      "label": "Name Format",
      "options": [
        "clan",
        "lineage",
        "name"
      ],
      "optionLabels": {
        "clan": "Name and clan (Dagrik Stonevein)",
        "lineage": "Son or daughter of… (Dagrik son of Torval)",
        "name": "First name only"
      }
    }
  },
  "recipe": "switch",
  "on": "format",
  "cases": {
    "name": {
      "recipe": "switch",
      "on": "gender",
      "cases": {
        "any": {
          "recipe": "pick",
          "from": "first"
        }
      },
      "default": {
        "recipe": "pick",
        "from": "first.{gender}"
      }
    },
    "clan": {
      "recipe": "switch",
      "on": "gender",
      "cases": {
        "any": {
          "recipe": "template",
          "template": "[first] [clans.{kind}]"
        }
      },
      "default": {
        "recipe": "template",
        "template": "[first.{gender}] [clans.{kind}]"
      }
    },
    "lineage": {
      "recipe": "switch",
      "on": "gender",
      "cases": {
        "any": {
          "recipe": "template",
          "template": [
            "[first.male] son of [first.male]",
            "[first.female] daughter of [first.male]"
          ]
        },
        "male": {
          "recipe": "template",
          "template": "[first.male] son of [first.male]"
        },
        "female": {
          "recipe": "template",
          "template": "[first.female] daughter of [first.male]"
        }
      }
    }
  },
