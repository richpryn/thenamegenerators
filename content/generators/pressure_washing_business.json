    "hero": {
      "title": "💧 Pressure Washing Business Name Generator",
      "tagline": "Names for pressure washing firms, from Moss Boss to Clearview Exterior Cleaning."
    },
    "intro": "Starting a pressure washing, power washing or jet washing round? This **pressure washing business name generator** has catchy and funny names, classic and professional ones for exterior cleaning firms, short modern names, plus names from your town or first name.",
    "sections": [],
    "faqs": [
      {
        "question": "How do I check a pressure washing business name is free?",
        "answer": "Press <strong>Check</strong> next to any name to see if it's free as a company, a domain and a social media handle. Then make sure: in the UK, search Companies House and the UK IPO trade mark register; in the US, search your state's business register and the USPTO trade mark search. A quick map search for the name in your area helps too."
      },
      {
        "question": "What are some pressure washing slogans that rhyme?",
        "answer": "Rhymes stick in the memory, which helps on a van or a flyer: <em>From grime to shine</em>, <em>Dirt goes, beauty shows</em> or <em>Brick by brick, we make it slick</em>. Choose <strong>Name with a slogan</strong> in the Format menu to see names paired with one."
      }
    ]
