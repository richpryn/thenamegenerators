{
  "title": "Fantasy Country Name Generator",
  "seoTitle": "Fantasy Country and Kingdom Name Generator",
  "slug": "fantasy-country-name-generator",
  "icon": "🗺️",
  "category": "places",
  "published": "2025-11-30",
  "description": "Fantasy country and kingdom names in six styles, from elvish realms and Norse jarldoms to Latin empires and island thalassocracies, with or without a title.",
  "seoKeywords": "fantasy country names, fantasy kingdom names, country name generator, fantasy nation names, dnd country names, kingdom name generator, worldbuilding country names",
  "isPopular": true,
  "popularRank": 6,
  "filters": {
    "style": {
      "label": "Style",
      "options": [
        "any",
        "elvish",
        "northern",
        "imperial",
        "old_kingdom",
        "dark",
        "island"
      ],
      "optionLabels": {
        "any": "Any style",
        "elvish": "Elvish and flowing",
        "northern": "Northern and Norse",
        "imperial": "Imperial and Latin",
        "old_kingdom": "Old English kingdoms",
        "dark": "Dark and dangerous",
        "island": "Islands and the sea"
      }
    },
    "format": {
      "label": "Name Format",
      "options": [
        "name",
        "title"
      ],
      "optionLabels": {
        "name": "Name only (Valdheim)",
        "title": "With a title (Kingdom of Valdheim)"
      }
    }
  },
  "recipe": "switch",
  "on": "format",
  "cases": {
    "name": {
      "recipe": "switch",
      "on": "style",
      "cases": {
        "any": {
          "recipe": "pick",
          "from": "names"
        }
      },
      "default": {
        "recipe": "pick",
        "from": "names.{style}"
      }
    },
    "title": {
      "recipe": "switch",
      "on": "style",
      "cases": {
        "any": {
          "recipe": "template",
          "template": [
            "Kingdom of [names.elvish]",
            "The Realm of [names.elvish]",
            "The Woodland Realm of [names.elvish]",
            "High Kingdom of [names.elvish]",
            "Kingdom of [names.northern]",
            "The [names.northern] Jarldoms",
            "The Thanes of [names.northern]",
            "High Kingdom of [names.northern]",
            "The [names.imperial] Empire",
