  "startsWith": "letter",
  "recipe": "switch",
  "on": "format",
  "cases": {
    "deed": {
      "recipe": "switch",
      "on": "gender",
      "cases": {
        "any": {
          "recipe": "template",
          "template": "[names] [deed.first][deed.second]"
        }
      },
      "default": {
        "recipe": "template",
        "template": "[names.{gender}] [deed.first][deed.second]"
      }
    },
    "the": {
      "recipe": "switch",
      "on": "gender",
      "cases": {
        "any": {
          "recipe": "template",
          "template": "[names] the [the]"
        }
      },
      "default": {
        "recipe": "template",
        "template": "[names.{gender}] the [the]"
      }
    },
    "clan": {
      "recipe": "switch",
      "on": "gender",
      "cases": {
        "any": {
          "recipe": "template",
          "template": "[names] of the [clan.adjective] [clan.noun]"
        }
      },
      "default": {
        "recipe": "template",
        "template": "[names.{gender}] of the [clan.adjective] [clan.noun]"
      }
    },
    "name": {
      "recipe": "switch",
      "on": "gender",
      "cases": {
        "any": {
          "recipe": "template",
          "template": "[names]"
        }
      },
      "default": {
        "recipe": "template",
        "template": "[names.{gender}]"
      }
    },
    "shaman": {
      "recipe": "switch",
      "on": "gender",
      "cases": {
        "any": {
          "recipe": "template",
          "template": [
            "[names] [shaman.title]",
            "[names] the [shaman.the]",
            "[names], Speaker for the [shaman.spirits]"
          ]
        }
      },
      "default": {
        "recipe": "template",
        "template": [
          "[names.{gender}] [shaman.title]",
          "[names.{gender}] the [shaman.the]",
          "[names.{gender}], Speaker for the [shaman.spirits]"
        ]
      }
    }
  },
