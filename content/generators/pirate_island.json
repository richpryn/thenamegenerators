{
  "title": "Pirate Island Name Generator",
  "seoTitle": "Pirate Island Name Generator: Treasure Islands & Ports",
  "slug": "pirate-island-name-generator",
  "icon": "🏴‍☠️",
  "category": "places",
  "published": "2026-10-25",
  "description": "Pirate island names for treasure islands, pirate ports, cursed isles, hidden tropical hideouts and funny islands, with an optional description.",
  "seoKeywords": "pirate island name generator, pirate island names, pirate island name ideas, random pirate island name generator, pirate island names dnd, cool pirate island names, funny pirate island names, fantasy pirate island names, treasure island name generator, treasure island name ideas, pirate port names, pirate town name generator, pirate cove names, cursed island names, cursed island name generator",
  "isPopular": false,
  "noEcho": true,
  "filters": {
    "style": {
      "label": "Kind of Island",
      "options": [
        "any",
        "treasure",
        "haven",
        "cursed",
        "tropical",
        "funny"
      ],
      "optionLabels": {
        "any": "Any kind of island",
        "treasure": "Treasure (Ten Paces Island)",
        "haven": "Pirate port (Port Gangplank)",
        "cursed": "Cursed (Isla Maldita)",
        "tropical": "Hideout (Behind the Falls)",
        "funny": "Funny (Wrong Map Island)"
      }
    },
    "format": {
      "label": "Name Format",
      "options": [
        "name",
        "desc"
      ],
      "optionLabels": {
        "name": "Name only (Dig Here Cay)",
        "desc": "With a description"
      }
    }
  },
  "recipe": "switch",
  "on": "format",
  "cases": {
    "name": {
      "recipe": "switch",
      "on": "style",
      "cases": {
        "any": {
          "recipe": "pick",
          "from": "names"
        }
      },
      "default": {
        "recipe": "pick",
        "from": "names.{style}"
      }
    },
    "desc": {
      "recipe": "switch",
      "on": "style",
      "cases": {
        "any": {
          "recipe": "template",
          "template": [
            "[names.treasure], [desc.treasure]",
            "[names.haven], [desc.haven]",
            "[names.cursed], [desc.cursed]",
            "[names.tropical], [desc.tropical]",
            "[names.funny], [desc.funny]"
          ]
        }
      },
      "default": {
        "recipe": "template",
        "template": "[names.{style}], [desc.{style}]"
      }
    }
  },
