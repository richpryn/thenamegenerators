{
  "title": "Dungeon Synth Name Generator",
  "slug": "dungeon-synth-name-generator",
  "icon": "🎵",
  "category": "music",
  "published": "2025-11-30",
  "description": "Names for dungeon synth projects and albums in four styles: dark and medieval, nature and fantasy, cosy comfy synth, and cosmic.",
  "seoKeywords": "dungeon synth names, dungeon synth project names, dark ambient names, medieval music names, fantasy music names, atmospheric music names, cosmic synth names, space synth names, comfy synth names, dungeon synth album names",
  "isPopular": true,
  "popularRank": 1,
  "filters": {
    "style": {
      "label": "Style",
      "options": [
        "any",
        "dark",
        "nature",
        "cosy",
        "cosmic"
      ],
      "optionLabels": {
        "any": "Any style",
        "dark": "Dark and medieval",
        "nature": "Nature and fantasy",
        "cosy": "Comfy synth (cosy)",
        "cosmic": "Cosmic and space synth"
      }
    },
    "format": {
      "label": "Name format",
      "options": [
        "project",
        "album"
      ],
      "optionLabels": {
        "project": "Project name (Torchless Halls)",
        "album": "Album title (Return to the Black Tower)"
      }
    }
  },
  "recipe": "switch",
  "on": "format",
  "cases": {
    "project": {
      "recipe": "switch",
      "on": "style",
      "cases": {
        "dark": {
          "recipe": "template",
          "template": "[project.dark]"
        },
        "nature": {
          "recipe": "template",
          "template": "[project.nature]"
        },
        "cosy": {
          "recipe": "template",
          "template": "[project.cosy]"
        },
        "cosmic": {
          "recipe": "template",
          "template": "[project.cosmic]"
        },
        "any": {
          "recipe": "template",
          "template": [
            "[project.dark]",
            "[project.nature]",
            "[project.cosy]",
            "[project.cosmic]"
          ]
        }
      }
    },
    "album": {
      "recipe": "switch",
      "on": "style",
      "cases": {
        "dark": {
          "recipe": "template",
          "template": [
            "[album.dark.deed] [album.dark.place]",
            "[album.dark.adj] [album.dark.noun]",
            "Of [album.dark.noun] and [album.dark.noun]",
            "The [album.dark.adj] Kingdom",
            "The Book of [album.dark.adj] [album.dark.noun]"
          ]
        },
        "nature": {
          "recipe": "template",
          "template": [
            "[album.nature.deed] [album.nature.place]",
            "[album.nature.season] in [album.nature.place]",
            "Of [album.nature.noun] and [album.nature.noun]",
            "[album.nature.season] [album.nature.noun]"
          ]
        },
        "cosy": {
          "recipe": "template",
          "template": [
            "[album.cosy.deed] [album.cosy.place]",
            "[album.cosy.thing] and [album.cosy.thing]",
            "[album.cosy.adj] [album.cosy.thing]",
            "A [album.cosy.adj] Year at [album.cosy.place]"
          ]
        },
        "cosmic": {
          "recipe": "template",
          "template": [
            "[album.cosmic.deed] [album.cosmic.place]",
            "[album.cosmic.adj] [album.cosmic.thing]",
            "Of [album.cosmic.thing] and [album.cosmic.thing]",
            "The Book of [album.cosmic.adj] [album.cosmic.thing]"
          ]
        },
        "any": {
          "recipe": "template",
          "template": [
            "[album.dark.deed] [album.dark.place]",
            "[album.dark.adj] [album.dark.noun]",
            "Of [album.dark.noun] and [album.dark.noun]",
            "The [album.dark.adj] Kingdom",
            "The Book of [album.dark.adj] [album.dark.noun]",
            "[album.nature.deed] [album.nature.place]",
            "[album.nature.season] in [album.nature.place]",
            "Of [album.nature.noun] and [album.nature.noun]",
            "[album.nature.season] [album.nature.noun]",
            "[album.cosy.deed] [album.cosy.place]",
            "[album.cosy.thing] and [album.cosy.thing]",
            "[album.cosy.adj] [album.cosy.thing]",
            "A [album.cosy.adj] Year at [album.cosy.place]",
            "[album.cosmic.deed] [album.cosmic.place]",
            "[album.cosmic.adj] [album.cosmic.thing]",
            "Of [album.cosmic.thing] and [album.cosmic.thing]",
            "The Book of [album.cosmic.adj] [album.cosmic.thing]"
          ]
        }
      }
    }
  },
