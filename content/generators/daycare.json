    "hero": {
      "title": "🧸 Daycare Name Generator",
      "tagline": "Names for a daycare, nursery, pre-school or childminder, from Little Acorns to The Tot Spot."
    },
    "intro": "Parents choose childcare on trust, so the name should sound warm, safe and easy to remember. This **Daycare Name Generator** suggests names for daycares, child care centers, UK nurseries, pre-schools and childminders, with US or UK wording and names built from your town or your own name.",
    "sections": [],
    "faqs": [
      {
        "question": "How do I check a daycare name is free?",
        "answer": "Press **Check** on any name to see whether it's free as a company name, a domain and a social media handle. Before you commit, search the official registers too: in the UK, Companies House; in the US, your state's business register and the USPTO trade mark search."
      },
      {
        "question": "What should I name my daycare?",
        "answer": "Pick a name that feels warm and safe and is easy for parents to say and spell, then add a word that says what you offer: <em>Daycare</em> or <em>Child Care Center</em> in the US, <em>Day Nursery</em> or <em>Pre-School</em> in the UK, or <em>Childminding</em> if you look after children in your own home. Nature and animal words (Little Acorns, Owlets) are popular, and a home daycare or childminder often uses the owner's name, like <em>Miss Sarah's Daycare</em>."
      }
    ]
  }
