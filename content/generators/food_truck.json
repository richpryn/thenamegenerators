  "article": {
    "hero": {
      "title": "🚚 Food Truck Name Generator",
      "tagline": "Names for a food truck, food van or street food stall, from Wheel Good Food to Bessie the Burger Van."
    },
    "intro": "A food truck name has to work painted on the side of a van, shouted across a festival field and typed into Instagram. This **food truck name generator** gives you names in eight styles, from punny to taco and BBQ names, for trucks in the US and food vans in the UK.",
    "sections": [],
    "faqs": [
      {
        "question": "How do I check a food truck name is free?",
        "answer": "Press <strong>Check</strong> on any name to see whether it's free as a company name, a domain and a social media handle. Before you commit, search the official registers too: in the UK, Companies House and the UK trade mark register; in the US, your state's business register and the USPTO trade mark search. Look on a map app for businesses with the same name nearby."
      },
