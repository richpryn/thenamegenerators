{
  "title": "Viking Name Generator",
  "slug": "viking-name-generator",
  "icon": "⛵",
  "category": "people",
  "published": "2026-10-20",
  "description": "Real Old Norse names with a patronymic (Leifsson, Haraldsdóttir) or a byname like Erik the Red and Harald Fairhair, the way Vikings were actually known.",
  "seoKeywords": "viking name generator, viking names, norse name generator, old norse names, female viking names, viking last names, norse names with meanings",
  "isPopular": false,
  "filters": {
    "gender": {
      "label": "Gender",
      "options": [
        "any",
        "male",
        "female"
      ],
      "optionLabels": {
        "any": "Any"
      }
    },
    "format": {
      "label": "Name format",
      "options": [
        "any",
        "patronymic",
        "byname",
        "first"
      ],
      "optionLabels": {
        "any": "Any (a mix)",
        "patronymic": "Patronymic (son or daughter of)",
        "byname": "Byname (Erik the Red)",
        "first": "First name only"
      }
    }
  },
  "recipe": "switch",
  "on": "format",
  "cases": {
    "patronymic": {
      "recipe": "switch",
      "on": "gender",
      "cases": {
        "male": {
          "recipe": "template",
          "template": "[first.male] [patronym.son]"
        },
        "female": {
          "recipe": "template",
          "template": "[first.female] [patronym.dottir]"
        },
        "any": {
          "recipe": "template",
          "template": [
            "[first.male] [patronym.son]",
            "[first.female] [patronym.dottir]"
          ]
        }
      }
    },
    "byname": {
      "recipe": "switch",
      "on": "gender",
      "cases": {
        "any": {
          "recipe": "template",
          "template": [
            "[first.male] [bynames]",
            "[first.female] [bynames_f]"
          ]
        },
        "male": {
          "recipe": "template",
          "template": "[first.male] [bynames]"
        },
        "female": {
          "recipe": "template",
          "template": "[first.female] [bynames_f]"
        }
      }
    },
    "first": {
      "recipe": "switch",
      "on": "gender",
      "cases": {
        "any": {
          "recipe": "template",
          "template": "[first]"
        }
      },
      "default": {
        "recipe": "template",
        "template": "[first.{gender}]"
      }
    },
    "any": {
      "recipe": "switch",
      "on": "gender",
      "cases": {
        "male": {
          "recipe": "template",
          "template": [
            "[first.male] [patronym.son]",
            "[first.male] [bynames]"
          ]
        },
        "female": {
          "recipe": "template",
          "template": [
            "[first.female] [patronym.dottir]",
            "[first.female] [bynames_f]"
          ]
        },
        "any": {
          "recipe": "template",
          "template": [
            "[first.male] [patronym.son]",
            "[first.male] [bynames]",
            "[first.female] [patronym.dottir]",
            "[first.female] [bynames_f]"
          ]
        }
      }
    }
  },
