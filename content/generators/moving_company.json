  "article": {
    "hero": {
      "title": "🚚 Moving Company Name Generator",
      "tagline": "Names for movers and removals firms, from Sofa So Good to Hartley & Sons Removals."
    },
    "intro": "Starting a moving company, a removals firm or a man and van business? This **moving company name generator** has catchy and funny puns, classic family names, short modern names and names for small moves, plus names from your town or first name.",
    "sections": [],
    "faqs": [
      {
        "question": "How do I check a moving company name is free?",
        "answer": "Press <strong>Check</strong> next to any name to see if it's free as a company, a domain and a social media handle. Then make sure: in the UK, search Companies House and the UK IPO trade mark register; in the US, search your state's business register and the USPTO trade mark search. A quick map search for the name in your area helps too."
      },
      {
        "question": "What's a good name for a moving company?",
        "answer": "Movers are trusted with everything a family owns, so names that sound careful and dependable work well: <em>Hartley & Sons Removals</em>, <em>Careful Hands Movers</em> or <em>Steve's Man & Van</em>. A friendly pun like <em>Sofa So Good</em> looks great on the side of a van. In the UK, &ldquo;Removals&rdquo; is the usual word; in the US, &ldquo;Movers&rdquo; or &ldquo;Moving & Storage&rdquo;."
      }
    ]
  },
