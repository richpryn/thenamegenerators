  "published": "2025-11-30",
  "description": "World of Warcraft orc names that fit the game's name rules, plus an earned surname or a Horde clan for your character's story. Male and female.",
  "seoKeywords": "wow orc names, world of warcraft orc names, warcraft orc names, horde orc names, wow character names, orc name generator",
  "isPopular": true,
  "popularRank": 6,
  "filters": {
    "gender": {
      "label": "Gender",
      "options": [
        "any",
        "male",
        "female"
      ],
      "optionLabels": {
        "any": "Any",
        "male": "Male",
        "female": "Female"
      }
    },
    "format": {
      "label": "Name Format",
      "options": [
        "game",
        "surname",
        "clan"
