      "optionLabels": {
        "game": "Character name, fits in game (Rokgath)",
        "surname": "With an earned surname (Rokgath Ashbrand)",
        "clan": "With a clan (Rokgath of the Frostwolf clan)"
      }
    }
  },
  "recipe": "switch",
  "on": "format",
  "cases": {
    "game": {
      "recipe": "switch",
      "on": "gender",
      "cases": {
        "any": {
          "recipe": "template",
          "template": "[names]"
        }
      },
      "default": {
        "recipe": "template",
        "template": "[names.{gender}]"
      }
    },
    "surname": {
      "recipe": "switch",
      "on": "gender",
      "cases": {
        "any": {
          "recipe": "template",
          "template": "[names] [surnames]"
        }
      },
      "default": {
        "recipe": "template",
        "template": "[names.{gender}] [surnames]"
      }
    },
    "clan": {
      "recipe": "switch",
      "on": "gender",
      "cases": {
        "any": {
          "recipe": "template",
          "template": "[names] of the [clans] clan"
        }
      },
      "default": {
        "recipe": "template",
        "template": "[names.{gender}] of the [clans] clan"
      }
    }
  },
