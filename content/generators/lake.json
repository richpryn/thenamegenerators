{
  "title": "Lake Name Generator",
  "seoTitle": "Lake Name Generator: Fantasy, Loch, Dark & Magic Lakes",
  "slug": "lake-name-generator",
  "icon": "🛶",
  "category": "worldbuilding",
  "published": "2026-10-25",
  "description": "Lake names for maps, D&D and stories: fantasy lakes, British lochs, meres, tarns and llyns, dark haunted waters and crystal-clear magical lakes.",
  "seoKeywords": "lake name generator, lake name generator fantasy, lake name generator dnd, random lake name generator, fictional lake name generator, fantasy lake names, fantasy lake names generator, fantasy lake name ideas, dark fantasy lake names, dnd lake names, loch name generator",
  "isPopular": false,
  "filters": {
    "style": {
      "label": "Style",
      "options": [
        "any",
        "fantasy",
        "british",
        "dark",
        "crystal"
      ],
      "optionLabels": {
        "any": "Any style",
        "fantasy": "Fantasy (Lake Valcaster)",
        "british": "British (Loch Arvaig)",
        "dark": "Dark (Widow's Tarn)",
        "crystal": "Crystal (Lake Moonglass)"
      }
    },
    "format": {
      "label": "Name Format",
      "options": [
        "name",
        "description"
      ],
      "optionLabels": {
        "name": "Name only (Curlew Tarn)",
        "description": "With a description"
      }
    }
  },
  "noEcho": true,
  "recipe": "switch",
  "on": "format",
  "cases": {
    "name": {
      "recipe": "switch",
      "on": "style",
      "cases": {
        "any": {
          "recipe": "pick",
          "from": "names"
        }
      },
      "default": {
        "recipe": "pick",
        "from": "names.{style}"
      }
    },
    "description": {
      "recipe": "switch",
      "on": "style",
      "cases": {
        "any": {
          "recipe": "template",
          "template": [
            "[names.fantasy], [descriptions.fantasy]",
            "[names.british], [descriptions.british]",
            "[names.dark], [descriptions.dark]",
            "[names.crystal], [descriptions.crystal]"
          ]
        }
      },
      "default": {
        "recipe": "template",
        "template": "[names.{style}], [descriptions.{style}]"
      }
    }
  },
