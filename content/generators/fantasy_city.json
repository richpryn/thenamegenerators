{
  "title": "Fantasy City Name Generator",
  "seoTitle": "Fantasy City Name Generator: Capitals, Ports and Fortresses",
  "slug": "fantasy-city-name-generator",
  "icon": "🏰",
  "category": "places",
  "published": "2025-12-01",
  "description": "Fantasy city names for capitals, fortresses, ports, northern holds, ancient ruins and river towns, with an epithet if you want one: \"the City of Bells\".",
  "seoKeywords": "fantasy city names, city name generator, fantasy capital names, dnd city names, fantasy port city names, worldbuilding city names",
  "isPopular": true,
  "popularRank": 6,
  "filters": {
    "feel": {
      "label": "Kind of City",
      "options": [
        "any",
        "capital",
        "fortress",
        "port",
        "northern",
        "ancient",
        "river"
      ],
      "optionLabels": {
        "any": "Any kind of city",
        "capital": "Shining capital",
        "fortress": "Fortress city",
        "port": "Port city",
        "northern": "Northern and frozen",
        "ancient": "Ancient and ruined",
        "river": "River and market city"
      }
    },
    "format": {
      "label": "Name Format",
      "options": [
        "name",
        "epithet"
      ],
      "optionLabels": {
        "name": "Name only (Silverspire)",
        "epithet": "With an epithet (Silverspire, the City of Bells)"
      }
    }
  },
  "recipe": "switch",
  "on": "format",
  "cases": {
    "name": {
      "recipe": "switch",
      "on": "feel",
      "cases": {
        "any": {
          "recipe": "pick",
          "from": "names"
        }
      },
      "default": {
        "recipe": "pick",
        "from": "names.{feel}"
      }
    },
    "epithet": {
      "recipe": "switch",
      "on": "feel",
      "cases": {
        "any": {
          "recipe": "template",
          "template": [
            "[names.capital], [epithets.capital]",
            "[names.fortress], [epithets.fortress]",
            "[names.port], [epithets.port]",
            "[names.northern], [epithets.northern]",
            "[names.ancient], [epithets.ancient]",
            "[names.river], [epithets.river]"
          ]
        }
      },
      "default": {
        "recipe": "template",
        "template": "[names.{feel}], [epithets.{feel}]"
      }
    }
  },
