  "description": "Sword names for heroes, villains and old kings, with an epithet or a description: Griefbane, Drinker of Souls; Sigeling, a pattern-welded sword.",
  "seoKeywords": "sword names, sword name generator, fantasy sword names, legendary sword names, cool sword names, dnd sword names, magic sword names",
  "isPopular": true,
  "popularRank": 3,
  "filters": {
    "mood": {
      "label": "Kind of Sword",
      "options": [
        "any",
        "heroic",
        "dark",
        "old"
      ],
      "optionLabels": {
        "any": "Any",
        "heroic": "Heroic (Oathwarden)",
        "dark": "Dark and cursed (Griefbane)",
        "old": "Old English (Sigeling)"
      }
    },
    "format": {
      "label": "Name Format",
      "options": [
        "epithet",
        "blade",
        "name"
      ],
      "optionLabels": {
        "epithet": "Name and epithet (Griefbane, Drinker of Souls)",
        "blade": "Name and description (Griefbane, a notched black longsword)",
        "name": "Name only"
      }
    }
  },
  "recipe": "switch",
  "on": "format",
  "cases": {
    "name": {
      "recipe": "switch",
      "on": "mood",
      "cases": {
        "any": {
          "recipe": "template",
          "template": [
            "[names.heroic]",
            "[names.dark]",
            "[names.old]"
          ]
        }
      },
      "default": {
        "recipe": "template",
        "template": "[names.{mood}]"
      }
    },
    "epithet": {
      "recipe": "switch",
      "on": "mood",
      "cases": {
        "any": {
          "recipe": "template",
          "template": [
            "[names.heroic], [epithets.heroic]",
            "[names.dark], [epithets.dark]",
            "[names.old], [epithets.old]"
          ]
        }
      },
      "default": {
        "recipe": "template",
        "template": "[names.{mood}], [epithets.{mood}]"
      }
    },
    "blade": {
      "recipe": "switch",
      "on": "mood",
      "cases": {
        "any": {
          "recipe": "template",
          "template": [
            "[names.heroic], [adjectives.heroic] [types]",
            "[names.dark], [adjectives.dark] [types]",
            "[names.old], [adjectives.old] [types]"
          ]
        }
      },
      "default": {
        "recipe": "template",
        "template": "[names.{mood}], [adjectives.{mood}] [types]"
      }
    }
  },
