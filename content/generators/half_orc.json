{
  "title": "Half-Orc Name Generator",
  "slug": "half-orc-name-generator",
  "icon": "🧌",
  "category": "fantasy",
  "published": "2025-11-30",
  "description": "Half-orc names for a character raised among humans, among orcs, or somewhere between, with a surname or deed-name to match. Male and female.",
  "seoKeywords": "half-orc names, half orc name generator, dnd half-orc names, fantasy half-orc names, half-orc character names, orc human hybrid names",
  "isPopular": true,
  "popularRank": 8,
  "filters": {
