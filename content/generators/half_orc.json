  "startsWith": "letter",
  "recipe": "switch",
  "on": "format",
  "cases": {
    "name": {
      "recipe": "switch",
      "on": "raised",
      "cases": {
        "both": {
          "recipe": "switch",
          "on": "gender",
          "cases": {
            "any": {
              "recipe": "template",
              "template": "[first.both]"
            }
          },
          "default": {
            "recipe": "template",
            "template": "[first.both.{gender}]"
          }
        },
        "human": {
          "recipe": "switch",
          "on": "gender",
          "cases": {
            "any": {
              "recipe": "template",
              "template": "[first.human]"
            }
          },
          "default": {
            "recipe": "template",
            "template": "[first.human.{gender}]"
          }
        },
        "orc": {
          "recipe": "switch",
          "on": "gender",
          "cases": {
            "any": {
              "recipe": "template",
              "template": "[first.orc]"
            }
          },
          "default": {
            "recipe": "template",
            "template": "[first.orc.{gender}]"
          }
        }
      }
    },
    "full": {
      "recipe": "switch",
      "on": "raised",
      "cases": {
        "both": {
          "recipe": "switch",
          "on": "gender",
          "cases": {
            "any": {
              "recipe": "template",
              "template": [
                "[first.both] [human_surnames]",
                "[first.both] [deed.first][deed.second]"
              ]
            }
          },
          "default": {
            "recipe": "template",
            "template": [
              "[first.both.{gender}] [human_surnames]",
              "[first.both.{gender}] [deed.first][deed.second]"
            ]
          }
        },
        "human": {
          "recipe": "switch",
          "on": "gender",
          "cases": {
            "any": {
              "recipe": "template",
              "template": "[first.human] [human_surnames]"
            }
          },
          "default": {
            "recipe": "template",
            "template": "[first.human.{gender}] [human_surnames]"
          }
        },
        "orc": {
          "recipe": "switch",
          "on": "gender",
          "cases": {
            "any": {
              "recipe": "template",
              "template": "[first.orc] [deed.first][deed.second]"
            }
          },
          "default": {
            "recipe": "template",
            "template": "[first.orc.{gender}] [deed.first][deed.second]"
          }
        }
      }
    }
  },
