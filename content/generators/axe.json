{
  "title": "Axe Name Generator",
  "slug": "axe-name-generator",
  "icon": "🪓",
  "category": "objects",
  "published": "2025-12-01",
  "description": "Axe names in four styles: Norse axes named like troll-women, dwarven heirlooms, brutal orc cleavers and a woodsman's Old Bess, with an epithet or description.",
  "seoKeywords": "axe names, axe name generator, fantasy axe names, viking axe names, battle axe names, dwarf axe names, dnd axe names",
  "isPopular": true,
  "popularRank": 4,
  "filters": {
    "kind": {
      "label": "Kind of Axe",
      "options": [
        "any",
        "norse",
        "dwarven",
        "brutal",
        "homely"
      ],
      "optionLabels": {
        "any": "Any",
        "norse": "Norse (Shieldtroll)",
        "dwarven": "Dwarven (Grudgehewer)",
        "brutal": "Brutal (Skullsplitter)",
        "homely": "Homely (Old Bess)"
      }
    },
    "format": {
      "label": "Name Format",
      "options": [
        "epithet",
        "axe",
        "name"
      ],
      "optionLabels": {
        "epithet": "Name and epithet (Shieldtroll, Feeder of Ravens)",
        "axe": "Name and description (Shieldtroll, a rune-cut bearded axe)",
        "name": "Name only"
      }
    }
  },
  "recipe": "switch",
  "on": "format",
  "cases": {
    "name": {
      "recipe": "switch",
      "on": "kind",
      "cases": {
        "any": {
          "recipe": "template",
          "template": [
            "[names.norse]",
            "[names.dwarven]",
            "[names.brutal]",
            "[names.homely]"
          ]
        }
      },
      "default": {
        "recipe": "template",
        "template": "[names.{kind}]"
      }
    },
    "epithet": {
      "recipe": "switch",
      "on": "kind",
      "cases": {
        "any": {
          "recipe": "template",
          "template": [
            "[names.norse], [epithets.norse]",
            "[names.dwarven], [epithets.dwarven]",
            "[names.brutal], [epithets.brutal]",
            "[names.homely], [epithets.homely]"
          ]
        }
      },
      "default": {
        "recipe": "template",
        "template": "[names.{kind}], [epithets.{kind}]"
      }
    },
    "axe": {
      "recipe": "switch",
      "on": "kind",
      "cases": {
        "any": {
          "recipe": "template",
          "template": [
            "[names.norse], [adjectives] [types]",
            "[names.dwarven], [adjectives] [types]",
            "[names.brutal], [adjectives] [types]",
            "[names.homely], [adjectives] [types]"
          ]
        }
      },
      "default": {
        "recipe": "template",
        "template": "[names.{kind}], [adjectives] [types]"
      }
    }
  },
