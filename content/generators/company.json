{
  "title": "Company Name Generator",
  "slug": "company-name-generator",
  "icon": "🏢",
  "category": "organizations",
  "published": "2025-12-01",
  "description": "Startup-style company names in five styles: invented words, blends, -ify and -ly endings, real words and two-part names. Plus how to check a name is free.",
  "seoKeywords": "company name generator, company names, startup name generator, startup names, tech company names, LLC name ideas, invented company names",
  "isPopular": true,
  "popularRank": 8,
  "filters": {
    "category": {
      "label": "Name Style",
      "options": [
        "any",
        "single_word",
        "portmanteau",
        "trendy_suffix",
        "invented",
        "combinations"
      ],
      "optionLabels": {
        "any": "Any style",
        "single_word": "Real words (Anchor, Helix)",
        "portmanteau": "Blends and coined words (Canvora, Brandify)",
        "trendy_suffix": "Word + ending (CloudForge, DataLoop)",
        "invented": "Invented words (Aevora, Ajorix)",
        "combinations": "Two words (Bright Path)"
      }
    }
  },
  "recipe": "switch",
  "on": "category",
  "cases": {
    "any": {
      "recipe": "template",
      "template": [
        "[single_word]",
        "[portmanteau]",
        "[trendy_suffix.prefixes][trendy_suffix.endings]",
        "[invented]",
        "[combinations]"
      ]
    },
    "trendy_suffix": {
      "recipe": "template",
      "template": "[trendy_suffix.prefixes][trendy_suffix.endings]"
    }
  },
  "default": {
    "recipe": "pick",
    "from": "{category}"
  },
