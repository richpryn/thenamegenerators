  "article": {
    "hero": {
      "title": "🧢 Streetwear Brand Name Generator",
      "tagline": "Names for a streetwear label, from Issue 04 to Night Owls Collective."
    },
    "intro": "Planning your first drop, a skate label or a crew that makes clothes? This **streetwear brand name generator** gives you names in eight styles, from drop culture to luxury streetwear, and you can check each one is free before you order blanks.",
    "sections": [],
    "faqs": [
      {
        "question": "How do I check a streetwear brand name is free?",
        "answer": "Press <strong>Check</strong> on any name to see whether it is free as a company name, a web address and a social media handle. In the UK, search the Companies House register; in the US, search your state's business register and the USPTO trade mark search. Do this before you pay for a logo, labels or signage."
      },
      {
        "question": "What makes a good streetwear brand name?",
        "answer": "Short, easy to say and good on a chest print or a neck label. Streetwear names often sound like a crew (<em>Night Owls Collective</em>), a catalogue number (<em>Issue 04</em>) or a skate term (<em>Grip Tape Goods</em>). Stay well clear of the big labels and their logos: Supreme, Palace and Stüssy guard their names closely, and clothing is a crowded trade mark class."
      }
    ]
  }
