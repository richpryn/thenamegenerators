  "article": {
    "hero": {
      "title": "🏃 Running Club Name Generator",
      "tagline": "Names for your running club, run crew, relay team or Saturday morning group."
    },
    "intro": "Most running clubs are named after their town plus a word like Harriers or Striders, while newer run crews go for something social or silly. This **Running Club Name Generator** makes both, plus names for women's groups, relay teams and charity runs.",
    "sections": [],
    "faqs": [
      {
        "question": "What are some funny running team names?",
        "answer": "Puns and honest jokes about pace go down well: Wheezy Does It, Calf Measures, The Agony of De-Feet or Will Run for Cake. Slow runners can own it with names like The Plodding Penguins or Back of the Pack. Choose Funny for more."
      },
      {
        "question": "What should I call a running group chat on WhatsApp?",
        "answer": "Something short that fits the group: Laps & Lattes for a coffee crew, Sole Sisters for a women's group, or your town plus Striders for a club. If you meet at the same parkrun each week, a name like The Saturday Breakfast Runners works well, but keep the word parkrun itself out of the name, as it's a trade mark."
      }
    ]
  }
