  "article": {
    "hero": {
      "title": "🌿 Therapy Practice Name Generator",
      "tagline": "Calm, trustworthy names for a private therapy, counselling or psychotherapy practice."
    },
    "intro": "A client often finds a therapist on a hard day, so the practice name should feel calm, safe and professional. This **Therapy Practice Name Generator** suggests names for therapy, counseling and psychotherapy practices with US or UK wording (counseling or counselling), including names built from your town or your own name.",
    "sections": [],
    "faqs": [
      {
        "question": "How do I check a therapy practice name is free?",
        "answer": "Press **Check** on any name to see whether it's free as a company name, a domain and a social media handle. Before you commit, search the official registers too: in the UK, Companies House; in the US, your state's business register and the USPTO trade mark search."
      },
      {
        "question": "Should I use my own name for my therapy practice?",
        "answer": "Many therapists in solo practice do, because clients are choosing a person: <em>Counselling with Sarah</em> or your full name plus <em>Psychotherapy</em> feels personal and is easy to check against your professional registration. A place or nature name (<em>Willow Tree Counseling</em>) suits you better if you plan to add colleagues or sell the practice one day. Avoid titles your registration does not allow, such as <em>Psychologist</em> in the UK unless you are registered with the HCPC."
      }
    ]
  }
